PORTAL_SESSION_JWT_SECRET="local-portal-session-jwt-secret"
PORTAL_SESSION_ACCESS_TTL_SECONDS=900
PORTAL_SESSION_REFRESH_TTL_DAYS=30
PORTAL_ENFORCE_SESSION_JWT=true

# Portal V2 demo controls (test-only)
NEXT_PUBLIC_PORTAL_DEMO_IN_SIDEBAR=true
