{
  "name": "marinantex",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:free-ports && npm run dev:infra && concurrently -n web,api,mail -c cyan,green,magenta \"npm run dev:web\" \"npm run dev:api\" \"npm run dev:mail\"",
    "dev:free-ports": "node scripts/free-dev-ports.mjs",
    "dev:infra": "docker compose up -d postgres redis minio",
    "dev:web": "next dev -p 3000",
    "dev:web:editor": "npm run dev -w @marinantex/web",
    "dev:api": "npm run start:dev -w @marinantex/api",
    "dev:mail": "node scripts/dev-mail-workspace.mjs",
    "build": "next build && npm run build -w @marinantex/api",
    "build:web:editor": "npm run build -w @marinantex/web",
    "lint": "npm run lint -w @marinantex/web && npm run lint -w @marinantex/api",
    "typecheck": "npm run typecheck:web && npm run typecheck:api",
    "typecheck:web": "npm run typecheck -w @marinantex/web",
    "typecheck:api": "npm run lint -w @marinantex/api",
    "typecheck:lexoffice": "npm run typecheck --prefix lexoffice-ai",
    "typecheck:all": "npm run typecheck && npm run typecheck:lexoffice",
    "test": "npm run test:web && npm run test:api",
    "test:web": "vitest run",
    "test:api": "npm run test -w @marinantex/api",
    "test:udf:compat": "node scripts/run-udf-compat-check.mjs",
    "smoke:test": "node scripts/smoke-tests.mjs",
    "smoke:portal:endpoints": "node scripts/portal-endpoint-smoke.mjs",
    "smoke:security:cases": "node scripts/security-smoke-cases.mjs",
    "regression:cases:launch": "node scripts/regression-cases-launch.mjs",
    "smoke:search:live": "node scripts/live-search-smoke.mjs",
    "staging:portal:v2": "node scripts/portal-v2-staging-ops.mjs",
    "eval:rag-v3": "node scripts/run-rag-v3-evals.mjs",
    "report:evidence:gaps": "python3 backend/scripts/generate_evidence_gap_report.py",
    "backfill:rag:metadata-quality": "python3 backend/scripts/backfill_rag_v3_metadata_quality.py",
    "seed:rag:evidence": "python3 backend/scripts/seed_rag_v3_coverage_evidence.py",
    "eval:embeddings:tr": "node scripts/run-tr-embedding-benchmark.mjs",
    "import:tbmm:laws": "node scripts/import-tbmm-laws.mjs",
    "import:mevzuat:laws": "node scripts/import-mevzuat-laws.mjs",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down -v",
    "docker:logs": "docker compose logs -f",
    "docker:prod-local:up": "docker compose -f docker-compose.prod-local.yml up -d --build",
    "docker:prod-local:down": "docker compose -f docker-compose.prod-local.yml down -v",
    "docker:prod-local:logs": "docker compose -f docker-compose.prod-local.yml logs -f",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:seed": "prisma db seed --schema prisma/schema.prisma",
    "seed:portal:demo": "tsx scripts/seed-portal-demo.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "eslint-config-prettier": "^10.1.8",
    "tsx": "^4.21.0",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "@ai-sdk/cohere": "^3.0.22",
    "@ai-sdk/google": "^3.0.34",
    "@ai-sdk/openai": "^3.0.37",
    "@google/genai": "^1.46.0",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "@react-pdf/renderer": "^4.3.2",
    "@supabase/ssr": "^0.9.0",
    "@tanstack/react-query": "^5.90.21",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "ai": "^6.0.105",
    "date-fns": "^4.1.0",
    "decimal.js": "^10.6.0",
    "framer-motion": "^12.38.0",
    "google-news-url-decoder": "^1.1.3",
    "lucide-react": "^0.577.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.20.0",
    "prisma": "^7.6.0",
    "react-hook-form": "^7.72.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  }
}
