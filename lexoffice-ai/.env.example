NODE_ENV=development
APP_NAME=LexOffice AI
APP_URL=http://localhost:3000
MAIL_WORKSPACE_BASE_PATH=/mail-workspace
MAIL_WORKSPACE_EMBED_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lexoffice_ai
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=lexoffice-files
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_FORCE_PATH_STYLE=true

AUTH_SECRET=replace_with_64_char_secret
AUTH_COOKIE_DOMAIN=localhost
AUTH_COOKIE_SECURE=false

ENCRYPTION_MASTER_KEY=replace_with_32_byte_base64
TOKEN_ENCRYPTION_KEY=replace_with_32_byte_base64

GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
GMAIL_WEBHOOK_SECRET=
MICROSOFT_WEBHOOK_SECRET=
YANDEX_WEBHOOK_SECRET=
IMAP_SMTP_WEBHOOK_SECRET=
GMAIL_PUBSUB_TOPIC=
YANDEX_MAIL_API_BASE_URL=
MAIL_PROVIDER_LIVE=false
MAIL_PROVIDER_FORCE_STUB=false

ATTACHMENT_STORAGE_ROOT=.data/attachments
ATTACHMENT_STORAGE_DRIVER=local
ATTACHMENT_S3_REGION=us-east-1
ATTACHMENT_S3_ENDPOINT=http://localhost:9000
ATTACHMENT_S3_FORCE_PATH_STYLE=true
ATTACHMENT_S3_ACCESS_KEY_ID=minio
ATTACHMENT_S3_SECRET_ACCESS_KEY=minio123
ATTACHMENT_S3_QUARANTINE_BUCKET=lexoffice-attachments-quarantine
ATTACHMENT_S3_CLEAN_BUCKET=lexoffice-attachments-clean
ATTACHMENT_S3_SERVER_SIDE_ENCRYPTION=
ATTACHMENT_S3_KMS_KEY_ID=
ATTACHMENT_SIGNING_SECRET=
ATTACHMENT_MAX_SIZE_BYTES=26214400
ATTACHMENT_ALLOWED_MIME=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain,text/csv,image/jpeg,image/png,image/webp
ATTACHMENT_SCANNER_DRIVER=heuristic
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=20000
ATTACHMENT_SCANNER_HTTP_ENDPOINT=
ATTACHMENT_SCANNER_HTTP_API_KEY=
ATTACHMENT_SCANNER_HTTP_TIMEOUT_MS=20000
MFA_ISSUER=LexOffice AI

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_DEFAULT_PROVIDER=openai
LLM_DEFAULT_MODEL=gpt-4.1-mini

QUEUE_PREFIX=lexoffice
BULLMQ_CONCURRENCY=5
MAIL_SYNC_MOCK=true

OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
