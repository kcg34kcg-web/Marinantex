NODE_ENV=development
APP_NAME=LexOffice AI
APP_URL=http://localhost:3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lexoffice_ai
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=lexoffice-files
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_FORCE_PATH_STYLE=true

AUTH_SECRET=replace_with_64_char_secret
AUTH_COOKIE_DOMAIN=localhost
AUTH_COOKIE_SECURE=false

ENCRYPTION_MASTER_KEY=replace_with_32_byte_base64
TOKEN_ENCRYPTION_KEY=replace_with_32_byte_base64

GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
GMAIL_WEBHOOK_SECRET=
MICROSOFT_WEBHOOK_SECRET=
YANDEX_WEBHOOK_SECRET=
IMAP_SMTP_WEBHOOK_SECRET=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_DEFAULT_PROVIDER=openai
LLM_DEFAULT_MODEL=gpt-4.1-mini

QUEUE_PREFIX=lexoffice
BULLMQ_CONCURRENCY=5
MAIL_SYNC_MOCK=true

OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
