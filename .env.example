# Infrastructure ports
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# PostgreSQL
POSTGRES_USER=marinantex
POSTGRES_PASSWORD=marinantex
POSTGRES_DB=marinantex
DATABASE_URL=postgresql://marinantex:marinantex@localhost:5432/marinantex?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# MinIO / S3-compatible storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=documents
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key
S3_BUCKET=documents
S3_ALLOW_INSECURE_DEV_FALLBACK=false

# Export pipeline
EXPORT_QUEUE_NAME=document-export
EXPORT_URL_TTL_SECONDS=300
EXPORT_OBJECT_RETENTION_HOURS=168

# API hardening
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=120
API_BODY_LIMIT=2mb
CORS_ORIGINS=http://localhost:3000

# Auth baseline
JWT_SECRET=replace_with_a_long_random_secret_for_local_dev
JWT_EXPIRES_IN=15m

# App endpoints
WEB_PORT=3000
API_PORT=4000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Optional mail workspace proxy target (single-app bridge)
MAIL_WORKSPACE_PROXY_TARGET=http://localhost:3001
MAIL_WORKSPACE_PORT=3001
MAIL_WORKSPACE_AUTO_START=true
MAIL_WORKSPACE_TENANT_SLUG=demo-hukuk
MAIL_WORKSPACE_LOGIN_EMAIL=owner@demo.lexoffice.ai
MAIL_WORKSPACE_LOGIN_PASSWORD=ChangeMe123!

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Source search live adapter (RAG v3 backend)
SEARCH_BACKEND_MODE=live
SEARCH_REQUIRE_LIVE=false
SEARCH_ALLOW_MOCK=false
SEARCH_LIVE_RAG_BACKEND_URL=http://127.0.0.1:8000
SEARCH_LIVE_RAG_BACKEND_URLS=http://127.0.0.1:8000,http://127.0.0.1:8001
SEARCH_LIVE_TIMEOUT_MS=12000
SEARCH_LIVE_RAG_TIER=2
SEARCH_LIVE_JURISDICTION=TR
SEARCH_LIVE_ACL_TAGS=public,internal
# Optional tenant/auth headers for strict backend setups
SEARCH_LIVE_BUREAU_ID=
SEARCH_LIVE_USER_ID=
SEARCH_LIVE_ACCESS_LEVEL=MEMBER
SEARCH_LIVE_BEARER_TOKEN=
