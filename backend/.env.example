# ============================================================================
# Environment Configuration
# Copy this file to .env and fill in your actual values
# ============================================================================

# ============================================================================
# Database (Supabase)
# ============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here
SUPABASE_ANON_KEY=your_anon_key_here

# Postgres Direct Connection (for LangGraph checkpointer)
# Format: postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your_password@your_host:5432/postgres

# ============================================================================
# Redis (Cache & Pub/Sub)
# ============================================================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=  # Leave empty if no password

# ============================================================================
# LLM Providers (Fallback Chain)
# ============================================================================
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=  # Optional OpenAI-compatible endpoint (e.g. http://localhost:8008/v1)
ANTHROPIC_API_KEY=sk-ant-...
GROQ_API_KEY=gsk_...
QWEN_SERVING_BACKEND=auto
SGLANG_BASE_URL=  # Optional OpenAI-compatible SGLang endpoint (e.g. http://localhost:30000/v1)
LLM_TIER2_MODEL=Qwen/Qwen3-Next-80B-A3B-Instruct
LLM_TIER3_MODEL=Qwen/Qwen3-Next-80B-A3B-Thinking
AI_TIER_DUSUNCELI_MODEL=Qwen/Qwen3-Next-80B-A3B-Instruct
AI_TIER_DUSUNCELI_FALLBACK_MODEL=Qwen/Qwen3-Next-80B-A3B-Instruct
AI_TIER_UZMAN_MODEL=Qwen/Qwen3-Next-80B-A3B-Thinking
AI_TIER_UZMAN_FALLBACK_MODEL=Qwen/Qwen3-Next-80B-A3B-Instruct
QWEN_SERVED_MODEL=Qwen/Qwen3-Next-80B-A3B-Instruct

# ============================================================================
# Privacy & Security
# ============================================================================
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
PII_ENCRYPTION_KEY=your_64_character_hex_key_here

# JWT Secret (for auth tokens if needed)
JWT_SECRET_KEY=your_jwt_secret_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
AUTH_ENFORCE_BEARER=false
AUTH_REQUIRED_PATH_PREFIXES=/api/v1/rag,/api/v1/rag-v3,/api/v1/ingest
AUTH_VERIFY_JWT_SIGNATURE=true
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=
AUTH_JWT_USE_JWKS=false
AUTH_JWKS_URL=
AUTH_JWKS_CACHE_TTL_SECONDS=300
AUTH_JWKS_FETCH_TIMEOUT_SECONDS=3
AUTH_JWKS_ALLOWED_ALGORITHMS=RS256
AUTH_REQUIRE_JWKS_IN_PRODUCTION=true

# Runtime security contract (startup fail-closed checks)
SECURITY_RUNTIME_FAIL_CLOSED=true
SECURITY_REQUIRE_TLS=true
SECURITY_REQUIRE_KMS=true
SECURITY_REQUIRE_SECRET_ROTATION_EVIDENCE=true
SECURITY_ROTATION_EVIDENCE_FILE=docs/compliance/evidence/key-rotation-evidence.json
TLS_CERT_PATH=
KMS_KEY_ID=

# ============================================================================
# Application Settings
# ============================================================================
ENVIRONMENT=development  # development | production
LOG_LEVEL=info  # debug | info | warning | error
DEBUG=true

# API Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# ============================================================================
# Embeddings & Models
# ============================================================================
# Active default (matches infrastructure.config.Settings)
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BASE_URL=  # Optional OpenAI-compatible embeddings endpoint (e.g. http://localhost:8081/v1)
EMBEDDING_API_KEY=
EMBEDDING_BATCH_SIZE=512
EMBEDDING_SEND_DIMENSIONS_PARAM=true
EMBEDDING_FAIL_OPEN_ENABLED=true
EMBEDDING_FORCE_LOCAL_FALLBACK=false
EMBEDDING_AUTO_RESIZE_TO_TARGET=false
EMBEDDING_MODEL_LOCK_ENFORCED=true
EMBEDDING_MODEL_LOCK_FILE=evals/embedding_model_lock.tr.json

# Optional local alternative (if you switch provider/model in code + DB schema)
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_DIMENSIONS=1024
# EMBEDDING_BASE_URL=http://localhost:8081/v1
# EMBEDDING_API_KEY=tei-local
# EMBEDDING_SEND_DIMENSIONS_PARAM=false

# RAG v3 reranker (cross-encoder)
RAG_V3_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RAG_V3_RERANKER_ENABLED=true
RAG_V3_RERANKER_PROVIDER=auto
RAG_V3_RERANKER_BASE_URL=
RAG_V3_RERANKER_API_KEY=
RAG_V3_RERANKER_REQUEST_TIMEOUT_S=3.0
RAG_V3_RERANKER_TIMEOUT_S=4
RAG_V3_STRUCTURED_OUTPUT_RETRIES=0
RAG_V3_CLAIM_MIN_OVERLAP=0.22
RAG_V3_CLAIM_MIN_SUPPORTED_RATIO=0.70
RAG_V3_NO_ANSWER_ON_CLAIM_VERIFICATION_FAIL=true
RAG_V3_CLAIM_GRAPH_ENABLED=true
RAG_V3_CONSTRAINED_SYNTHESIS_ENABLED=true
RAG_V3_CITATION_SNIPPET_MIN_OVERLAP=0.18
RAG_V3_ITERATIVE_RETRIEVAL_ENABLED=true
RAG_V3_ITERATIVE_TOP_K=14
RAG_V3_DUAL_TEMPORAL_ENABLED=true
RAG_V3_DUAL_TEMPORAL_TOP_K=14
RAG_V3_HUMAN_REVIEW_ENABLED=true
RAG_V3_FEEDBACK_AUTO_CAPTURE_ENABLED=true
RAG_V3_RERANKER_RELEASE_GATE_ENABLED=false
LLM_PROVIDER_MAX_RETRIES=0
LLM_PROVIDER_TIMEOUT_S=6
LLM_PROVIDER_QUOTA_COOLDOWN_S=300
LLM_FORCE_EXTRACTIVE_ONLY=false
RAG_V3_TENANT_HARD_FAIL_MISSING_BUREAU=true
TENANT_ENFORCE_IN_DEV=true
RAG_V3_SINGLE_PIPELINE_ENFORCED=false
RAG_V3_SINGLE_PIPELINE_ROLLOUT_STAGE=dev
RAG_V3_MAX_INFLIGHT_REQUESTS=96
RAG_V3_QUEUE_TIMEOUT_MS=5000
RAG_V3_ADMISSION_MAX_QUERY_CHARS=4000
RAG_V3_ADMISSION_MAX_INPUT_TOKENS=6000
RAG_V3_INGEST_CONTRACT_VERSION=rag.v3.ingest.response.v1
RAG_V3_INGEST_SCHEMA_VERSION=rag.v3.ingest.response.schema.v1
RAG_V3_QUERY_CONTRACT_VERSION=rag.v3.query.response.v1
RAG_V3_QUERY_SCHEMA_VERSION=rag.v3.query.response.schema.v1
RAG_V3_REQUIRE_LEGAL_DISCLAIMER_ACK=true
RAG_V3_HUMAN_RESPONSIBILITY_NOTICE=Bu asistan bilgi ve taslak amaclidir; nihai hukuki sorumluluk yetkili insan uzmandadir.
RAG_V3_REQUIRE_AUTH_SUBJECT_FOR_MUTATIONS=true
RAG_V3_CITATION_REQUIRE_CORE_FIELDS=true
RAG_V3_ROUTE_STRICT_GROUNDING_ENFORCED=true
RAG_V3_SAFE_INTENT_NO_RAG_ENABLED=true
RAG_V3_TIER3_TRIGGER_ENABLED=true
RAG_V3_ENFORCE_TIER_STRATEGY_CONTRACT=true
RAG_V3_PROMPT_REGISTRY_ENABLED=true
RAG_V3_PROMPT_REGISTRY_PATH=prompts/rag_v3/registry.json
RAG_V3_QUERY_EXPANSION_ENABLED=true
RAG_V3_PARSER_ORCHESTRATION_ENABLED=true
RAG_V3_PARSER_ENGINE_ORDER=mineru,docling,paddleocr_vl,builtin
RAG_V3_PARSER_MINERU_ENABLED=true
RAG_V3_PARSER_DOCLING_ENABLED=true
RAG_V3_PARSER_PADDLEOCR_VL_ENABLED=true
RAG_V3_CASE_LAW_METADATA_CONTRACT_ENABLED=true
RAG_V3_CASE_LAW_REQUIRED_FIELDS=court,chamber,esas_no,karar_no,decision_date
RAG_V3_METADATA_REQUIRE_TEMPORAL_FIELD=true
RAG_V3_METADATA_REQUIRE_TOPIC_TAGS=true
RAG_V3_METADATA_TOPIC_MIN_COUNT=1
RAG_V3_TOPIC_TAG_AUTO_EXTRACT_ENABLED=true
RAG_V3_TRACE_REQUIRE_MODEL_MAPPING=true
RAG_V3_TRACE_MODEL_MAPPING_FAIL_CLOSED=true
RAG_V3_TRACE_MODEL_EXPECTED_FAMILY=qwen3-next-80b-a3b
RAG_V3_OFFICIAL_SOURCE_FRESHNESS_THRESHOLD_HOURS=24
RAG_V3_OFFICIAL_SOURCE_REGISTRY_JSON=docs/compliance/official-source-registry.json

# Turkish NLP (optional)
TURKISH_NER_MODEL=  # If using custom Turkish NER
KVKK_GLINER_ENABLED=false
KVKK_GLINER_MODEL=urchade/gliner_multi-v2.1
KVKK_GLINER_LABELS=person,location,organization,address,email,phone,iban,tckn,vkn
KVKK_GLINER_DEVICE=cpu
KVKK_GLINER_FAIL_CLOSED=false
KVKK_REDACTION_MODE=reversible
KVKK_REDACTION_MAP_BACKEND=memory
KVKK_REDACTION_MAP_TTL_SECONDS=900
KVKK_REDACTION_POLICY_PATH=backend/ops/policies/redaction-policy.yaml

# ============================================================================
# LangGraph & Checkpointer
# ============================================================================
# Checkpoint table name (will be created automatically)
CHECKPOINT_TABLE_NAME=langgraph_checkpoints

# ============================================================================
# Feature Flags (PHASE implementation toggles)
# ============================================================================
ENABLE_PRIVACY_MIDDLEWARE=true
ENABLE_SEMANTIC_ROUTER=true
ENABLE_TIME_TRAVEL=false  # PHASE 3
ENABLE_CITATION_ENGINE=false  # PHASE 4
ENABLE_LIVING_DOCUMENTS=false  # PHASE 4

# ============================================================================
# External Services (Future)
# ============================================================================
# Resmi Gazete scraper
RESMI_GAZETE_API_URL=
RESMI_GAZETE_API_KEY=

# Turkish Court System (UYAP) integration
UYAP_API_URL=
UYAP_API_KEY=
