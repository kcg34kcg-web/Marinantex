# Local serving profile (Ollama OpenAI-compatible endpoint)

OPENAI_BASE_URL=http://localhost:11434/v1

EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=1536
EMBEDDING_SEND_DIMENSIONS_PARAM=false
EMBEDDING_AUTO_RESIZE_TO_TARGET=true
EMBEDDING_FORCE_LOCAL_FALLBACK=false
EMBEDDING_MODEL_LOCK_ENFORCED=false

QWEN_SERVING_BACKEND=openai
QWEN_SERVED_MODEL=qwen2.5:3b
LLM_TIER2_MODEL=qwen2.5:3b
LLM_TIER3_MODEL=qwen2.5:3b
LLM_TIER4_MODEL=qwen2.5:3b

AI_TIER_HAZIR_PROVIDER=openai
AI_TIER_HAZIR_MODEL=qwen2.5:3b
AI_TIER_HAZIR_FALLBACK_PROVIDER=openai
AI_TIER_HAZIR_FALLBACK_MODEL=qwen2.5:3b
AI_TIER_DUSUNCELI_PROVIDER=openai
AI_TIER_DUSUNCELI_MODEL=qwen2.5:3b
AI_TIER_DUSUNCELI_FALLBACK_PROVIDER=openai
AI_TIER_DUSUNCELI_FALLBACK_MODEL=qwen2.5:3b
AI_TIER_UZMAN_PROVIDER=openai
AI_TIER_UZMAN_MODEL=qwen2.5:3b
AI_TIER_UZMAN_FALLBACK_PROVIDER=openai
AI_TIER_UZMAN_FALLBACK_MODEL=qwen2.5:3b
AI_TIER_MUAZZAM_PROVIDER=openai
AI_TIER_MUAZZAM_MODEL=qwen2.5:3b
AI_TIER_MUAZZAM_FALLBACK_PROVIDER=openai
AI_TIER_MUAZZAM_FALLBACK_MODEL=qwen2.5:3b

LLM_PROVIDER_TIMEOUT_S=40
LLM_FORCE_EXTRACTIVE_ONLY=false

RAG_V3_CITATION_REQUIRE_CORE_FIELDS=false
RAG_V3_ROUTE_STRICT_GROUNDING_ENFORCED=false
RAG_V3_SENTENCE_GROUNDING_REQUIRED=false
RAG_V3_NO_ANSWER_ON_CLAIM_VERIFICATION_FAIL=false
RAG_V3_CLAIM_SEMANTIC_ENABLED=false
RAG_V3_CLAIM_CONTRADICTION_BLOCKS_ANSWER=false
RAG_V3_CONSTRAINED_SYNTHESIS_ENABLED=false
RAG_V3_ANSWERABILITY_CHECK_ENABLED=true
RAG_V3_NO_ANSWER_MIN_SCORE=0.10
RAG_V3_ANSWERABILITY_MIN_OVERLAP=0.12
RAG_V3_CORPUS_VERIFIED=true
RAG_V3_RRF_SEMANTIC_WEIGHT=0.50
RAG_V3_RRF_KEYWORD_WEIGHT=1.50

RAG_V3_TRACE_MODEL_MAPPING_FAIL_CLOSED=false
RAG_V3_TRACE_MODEL_EXPECTED_FAMILY=qwen
RAG_V3_ENFORCE_TIER_STRATEGY_CONTRACT=false
