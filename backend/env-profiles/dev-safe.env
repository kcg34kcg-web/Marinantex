# Dev-safe profile (high availability / low fail-closed friction)

OPENAI_BASE_URL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_SEND_DIMENSIONS_PARAM=true
EMBEDDING_MODEL_LOCK_ENFORCED=true

EMBEDDING_FORCE_LOCAL_FALLBACK=true
EMBEDDING_AUTO_RESIZE_TO_TARGET=false

AI_TIER_HAZIR_PROVIDER=google
AI_TIER_HAZIR_MODEL=gemini-2.5-flash
AI_TIER_HAZIR_FALLBACK_PROVIDER=google
AI_TIER_HAZIR_FALLBACK_MODEL=gemini-2.0-flash
AI_TIER_DUSUNCELI_PROVIDER=google
AI_TIER_DUSUNCELI_MODEL=gemini-2.5-flash
AI_TIER_DUSUNCELI_FALLBACK_PROVIDER=google
AI_TIER_DUSUNCELI_FALLBACK_MODEL=gemini-2.0-flash
AI_TIER_UZMAN_PROVIDER=google
AI_TIER_UZMAN_MODEL=gemini-2.5-pro
AI_TIER_UZMAN_FALLBACK_PROVIDER=google
AI_TIER_UZMAN_FALLBACK_MODEL=gemini-2.5-flash
AI_TIER_MUAZZAM_PROVIDER=google
AI_TIER_MUAZZAM_MODEL=gemini-2.5-pro
AI_TIER_MUAZZAM_FALLBACK_PROVIDER=google
AI_TIER_MUAZZAM_FALLBACK_MODEL=gemini-2.5-flash

LLM_PROVIDER_TIMEOUT_S=20
LLM_FORCE_EXTRACTIVE_ONLY=true

RAG_V3_CITATION_REQUIRE_CORE_FIELDS=false
RAG_V3_ROUTE_STRICT_GROUNDING_ENFORCED=false
RAG_V3_SENTENCE_GROUNDING_REQUIRED=false
RAG_V3_NO_ANSWER_ON_CLAIM_VERIFICATION_FAIL=false
RAG_V3_CLAIM_SEMANTIC_ENABLED=false
RAG_V3_CLAIM_CONTRADICTION_BLOCKS_ANSWER=false
RAG_V3_CONSTRAINED_SYNTHESIS_ENABLED=false
RAG_V3_ANSWERABILITY_CHECK_ENABLED=false
RAG_V3_NO_ANSWER_MIN_SCORE=0.05
RAG_V3_ANSWERABILITY_MIN_OVERLAP=0.08
RAG_V3_CORPUS_VERIFIED=true
RAG_V3_RRF_SEMANTIC_WEIGHT=0.25
RAG_V3_RRF_KEYWORD_WEIGHT=2.5

RAG_V3_TRACE_MODEL_MAPPING_FAIL_CLOSED=false
RAG_V3_TRACE_MODEL_EXPECTED_FAMILY=gemini
RAG_V3_ENFORCE_TIER_STRATEGY_CONTRACT=false
