# Staging/prod-like strict profile (fail-closed contracts enabled)

OPENAI_BASE_URL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_SEND_DIMENSIONS_PARAM=true
EMBEDDING_MODEL_LOCK_ENFORCED=true

EMBEDDING_FORCE_LOCAL_FALLBACK=false
EMBEDDING_AUTO_RESIZE_TO_TARGET=false

AI_TIER_HAZIR_PROVIDER=openai
AI_TIER_HAZIR_MODEL=Qwen/Qwen3-Next-80B-A3B-Instruct
AI_TIER_HAZIR_FALLBACK_PROVIDER=openai
AI_TIER_HAZIR_FALLBACK_MODEL=Qwen/Qwen3-Next-80B-A3B-Instruct
AI_TIER_DUSUNCELI_PROVIDER=openai
AI_TIER_DUSUNCELI_MODEL=Qwen/Qwen3-Next-80B-A3B-Instruct
AI_TIER_DUSUNCELI_FALLBACK_PROVIDER=openai
AI_TIER_DUSUNCELI_FALLBACK_MODEL=Qwen/Qwen3-Next-80B-A3B-Instruct
AI_TIER_UZMAN_PROVIDER=openai
AI_TIER_UZMAN_MODEL=Qwen/Qwen3-Next-80B-A3B-Thinking
AI_TIER_UZMAN_FALLBACK_PROVIDER=openai
AI_TIER_UZMAN_FALLBACK_MODEL=Qwen/Qwen3-Next-80B-A3B-Instruct
AI_TIER_MUAZZAM_PROVIDER=openai
AI_TIER_MUAZZAM_MODEL=Qwen/Qwen3-Next-80B-A3B-Thinking
AI_TIER_MUAZZAM_FALLBACK_PROVIDER=openai
AI_TIER_MUAZZAM_FALLBACK_MODEL=Qwen/Qwen3-Next-80B-A3B-Thinking

LLM_PROVIDER_TIMEOUT_S=12
LLM_FORCE_EXTRACTIVE_ONLY=false

RAG_V3_CITATION_REQUIRE_CORE_FIELDS=true
RAG_V3_ROUTE_STRICT_GROUNDING_ENFORCED=true
RAG_V3_SENTENCE_GROUNDING_REQUIRED=true
RAG_V3_NO_ANSWER_ON_CLAIM_VERIFICATION_FAIL=true
RAG_V3_CLAIM_SEMANTIC_ENABLED=true
RAG_V3_CLAIM_CONTRADICTION_BLOCKS_ANSWER=true
RAG_V3_CONSTRAINED_SYNTHESIS_ENABLED=true
RAG_V3_ANSWERABILITY_CHECK_ENABLED=true
RAG_V3_NO_ANSWER_MIN_SCORE=0.20
RAG_V3_ANSWERABILITY_MIN_OVERLAP=0.18
RAG_V3_CORPUS_VERIFIED=false
RAG_V3_RRF_SEMANTIC_WEIGHT=1.0
RAG_V3_RRF_KEYWORD_WEIGHT=1.0

RAG_V3_TRACE_MODEL_MAPPING_FAIL_CLOSED=true
RAG_V3_TRACE_MODEL_EXPECTED_FAMILY=qwen3-next-80b-a3b
RAG_V3_ENFORCE_TIER_STRATEGY_CONTRACT=true
